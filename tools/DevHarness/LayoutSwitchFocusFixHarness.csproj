<Project Sdk="Microsoft.NET.Sdk">

  <!-- Companion plugin for valheim-dev-harness: test commands for LayoutSwitchFocusFix (real OS key presses, focus state). -->

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>LayoutSwitchFocusFixHarness</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitlyExpandNETStandardFacades>false</ImplicitlyExpandNETStandardFacades>
    <OutputPath>bin/$(Configuration)/</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(VALHEIM_DIR)</ValheimDir>
    <ManagedDir>$(ValheimDir)/valheim_Data/Managed</ManagedDir>
    <BepInExDir>$(ValheimDir)/BepInEx</BepInExDir>
    <!-- where valheim-dev-harness is checked out (built with `mise run build` there) -->
    <ValheimDevHarnessDir Condition="'$(ValheimDevHarnessDir)' == ''">$(MSBuildThisFileDirectory)../../../valheim-dev-harness</ValheimDevHarnessDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ValheimDevHarness" HintPath="$(ValheimDevHarnessDir)/DevHarness/bin/Release/ValheimDevHarness.dll" Private="false" />
    <Reference Include="LayoutSwitchFocusFix" HintPath="../../LayoutSwitchFocusFix/bin/$(Configuration)/LayoutSwitchFocusFix.dll" Publicize="true" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)/core/BepInEx.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)/assembly_valheim.dll" Publicize="true" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)/assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ManagedDir)/assembly_guiutils.dll" Private="false" />
    <Reference Include="gui_framework" HintPath="$(ManagedDir)/gui_framework.dll" Private="false" />
    <Reference Include="netstandard" HintPath="$(ManagedDir)/netstandard.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)/Unity.InputSystem.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)/Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>

</Project>
